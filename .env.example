# Panda Product OS — self-hosted environment template
# Copy to .env on the target host. Never commit real secrets.

NODE_ENV=production
WEB_PORT=3100
NEXT_PUBLIC_APP_URL=https://staging-product.panda-il.com

POSTGRES_DB=panda_product_os_staging
POSTGRES_USER=panda
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://panda:CHANGE_ME_STRONG_RANDOM_PASSWORD@postgres:5432/panda_product_os_staging

REDIS_URL=redis://redis:6379

AUTH_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
AUTH_URL=https://staging-product.panda-il.com
AUTH_TRUST_HOST=true

AI_PROVIDER=
AI_API_KEY=
